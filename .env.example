# ─── SEO / site configuration ───────────────────────────────────────────────
# Canonical production origin (no trailing slash). Used for canonical URLs,
# sitemap, robots, OpenGraph and JSON-LD. Defaults to https://www.akieni.com.
NEXT_PUBLIC_SITE_URL=https://www.akieni.com

NEXT_PUBLIC_SANITY_PROJECT_ID=83hnere0
NEXT_PUBLIC_SANITY_DATASET=development
SANITY_API_WRITE_TOKEN=


# Search engine ownership verification tokens (optional).
# Paste the value (not the full meta tag) from each console.
# Google Search Console → Settings → Ownership verification → HTML tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → the content value of the msvalidate.01 meta tag.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ─── Matomo analytics (self-hosted, cookieless) ─────────────────────────────
# Optional overrides — both default to the production instance (matomo.akieni.tech,
# site 2), so production needs no config. Set a different site id on Preview/
# staging deploys to keep that traffic out of the production dataset.
NEXT_PUBLIC_MATOMO_URL=//matomo.akieni.tech/
NEXT_PUBLIC_MATOMO_SITE_ID=2

# ─── Supabase (form submissions + admin dashboard data) ─────────────────────
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Service-role key — SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for BetterAuth's tables (server only).
# Supabase → Project Settings → Database → Connection string (use the pooler,
# port 6543, and append ?sslmode=require).
DATABASE_URL=

# ─── BetterAuth (Google login for /dashboard) ───────────────────────────────
# Random 32+ char secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Base URL of this app (used for OAuth callbacks). No trailing slash.
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth credentials (Google Cloud Console → Credentials → OAuth client).
# Authorized redirect URI must be: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated allowlist of admin emails permitted to access /dashboard.
ADMIN_EMAILS=fariol@akieni.tech

# ─── Email notifications (SMTP) ─────────────────────────────────────────────
# PLACEHOLDER — replace with your real SMTP credentials. Until SMTP_HOST is set,
# submissions still work and email sending is skipped (logged, not sent).
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (SSL), false for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# From address on outgoing notifications (defaults to SMTP_USER if unset).
MAIL_FROM=
# Inbox that receives new contact/application notifications.
MAIL_TO=
